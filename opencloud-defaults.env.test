# Environment file for opencloud stack
#
START_ADDITIONAL_SERVICES=
OC_DOCKER_IMAGE=docker.io/opencloudeu/opencloud-rolling
OC_DOCKER_TAG=9.1.0
OC_DOMAIN=cloud.opencloud.test
LOG_DRIVER=local
LOG_LEVEL=info
LOG_PRETTY=false
# do not use SSL between the reverse proxy and OpenCloud
PROXY_TLS=false
# INSECURE: needed if OpenCloud / reverse proxy is using self generated certificates
INSECURE=false
# basic auth (not recommended, but needed for eg. WebDav clients that do not support OpenID Connect)
PROXY_ENABLE_BASIC_AUTH=false
# demo users
DEMO_USERS=false
# admin password
INITIAL_ADMIN_PASSWORD=

# email server (if configured)
SMTP_HOST=
SMTP_PORT=
SMTP_SENDER=OpenCloud Notifications <notifications@cloud.opencloud.test>}"
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_INSECURE=false
SMTP_AUTHENTICATION=
SMTP_TRANSPORT_ENCRYPTION=none

FRONTEND_ARCHIVER_MAX_SIZE=10000000000
CHECK_FOR_UPDATES=true
PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml

# enable to allow using the banned passwords list
OC_PASSWORD_POLICY_BANNED_PASSWORDS_LIST=banned-password-list.txt
# control the password enforcement and policy for public shares
OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD=true
OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD=false
OC_PASSWORD_POLICY_DISABLED=false
OC_PASSWORD_POLICY_MIN_CHARACTERS=8
OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_DIGITS=1
OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS=1

# default language for services/WebUI; defaults to English, language code (ISO 639-1, e.g. de, en, fr)
DEFAULT_LANGUAGE=en

# Volumes
# stores configuration and data inside internal Podman volumes.
# This works fine for local development or quick evaluations — but is not suitable for production environments.
# Replace it with your desired location (e.g. %h/opencloud/config, where %h denotes the home-folder of the User.
OC_CONFIG_DIR=opencloud-config
OC_DATA_DIR=opencloud-data
OC_APPS_DIR=%h/.config/containers/systemd/config/opencloud/apps

# -------------------------------------------------
# TRAEFIK
# -------------------------------------------------

# Enable the Traefik ACME (Automatic Certificate Management Environment) for automatic SSL certificate management.
TRAEFIK_SERVICES_TLS_CONFIG="tls.certresolver=letsencrypt"
TRAEFIK_ACME_MAIL=example@example.org
TRAEFIK_ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory
TRAEFIK_CERTS_DIR=%h/.config/containers/systemd/certs
TRAEFIK_LOG_LEVEL=ERROR
TRAEFIK_ACCESS_LOG=false
TRAEFIK_PORT_HTTP=80
TRAEFIK_PORT_HTTPS=443
TRAEFIK_DASHBOARD=false
TRAEFIK_BASIC_AUTH_USERS=admin:$$apr1$$4vqie50r$$YQAmQdtmz5n9rEALhxJ4l.
TRAEFIK_DOMAIN=traefik.opencloud.test
DOCKER_SOCKET_PATH=/run/user/1000/podman/podman.sock

# -------------------------------------------------
# YJS
# -------------------------------------------------

YJS_DOCKER_IMAGE=opencloudeu/yjs
YJS_DOCKER_TAG=1.0.0
YJS_OPENCLOUD_URL=http://opencloud:9200
YJS_SHUTDOWN_GRACE_PERIOD_MS=15000
